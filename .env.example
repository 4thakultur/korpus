# Korpus configuration. Copy to .env and adjust. Every line is optional;
# the values shown are the defaults.

# --- Host side (Docker) -------------------------------------------------

# User and group Korpus runs as. Use the owner of the data directory
# (`id -u` / `id -g` on the host) so the database belongs to you.
PUID=1000
PGID=1000

# Where the database lives on the host. Can be an absolute path.
DATA_DIR=./data

# Address and port the web UI is published on. 127.0.0.1 = this machine
# only (for a reverse proxy on the same host). 0.0.0.0 = every network
# interface, needed when the proxy runs in another container or on another
# machine; Korpus speaks plain HTTP, so only do that on a network you trust
# (see "Security and network exposure" in the README).
KORPUS_HTTP_BIND=127.0.0.1
KORPUS_HTTP_PORT=9874

# --- Korpus ---------------------------------------------------------------

# Address and port to listen on, without Docker. The default only accepts
# local connections. In Docker the compose file sets 0.0.0.0:9874 inside the
# container and ignores this line.
#KORPUS_BIND=127.0.0.1:9874

# Host names this server answers to, comma-separated, besides IP addresses
# and localhost (always accepted). Add the name you open Korpus with, e.g.
# korpus.example.org or korpus.lan. Requests for other names are refused
# with 421, which blocks DNS rebinding attacks from websites you visit.
# "*" accepts any name (not recommended).
KORPUS_ALLOWED_HOSTS=

# Reverse proxies in front of Korpus, comma-separated IP addresses or CIDR
# ranges (e.g. 127.0.0.1 or, for a proxy reaching the Docker container,
# 172.16.0.0/12). Requests from these addresses are attributed to the client
# named in X-Forwarded-For, so failed logins are limited per client instead
# of for everyone together. List only proxies you control: a listed address
# can claim to be any client. Empty: X-Forwarded-For is ignored.
KORPUS_TRUSTED_PROXIES=

# SQLite database file, without Docker. Parent directories are created
# automatically. In Docker the database is always DATA_DIR/korpus.db.
#KORPUS_DATABASE_URL=sqlite://data/korpus.db

# IANA time zone used as the default during first-run setup
# (the active time zone is chosen in Settings).
KORPUS_DEFAULT_TIMEZONE=UTC

# Open Food Facts product lookup and search. When enabled, search words and
# barcodes you look up are sent to Open Food Facts; nothing else is.
KORPUS_OFF_ENABLED=true
KORPUS_OFF_BASE_URL=https://world.openfoodfacts.org
KORPUS_OFF_SEARCH_URL=https://search.openfoodfacts.org

# Contact (e-mail or URL) added to the User-Agent sent to Open Food Facts,
# as their API guidelines request. Recommended for public instances.
KORPUS_CONTACT=

# Timeout for external provider requests, in seconds (1-60).
KORPUS_PROVIDER_TIMEOUT_SECS=8

# Log filter (tracing EnvFilter syntax). Logs never contain diary contents.
KORPUS_LOG=korpus=info,tower_http=warn
