# Korpus configuration. Copy to .env and adjust. All values are optional.

# Address and port to listen on. The default only accepts local connections.
# In Docker the compose file sets 0.0.0.0:9874 inside the container.
KORPUS_BIND=127.0.0.1:9874

# SQLite database file. Parent directories are created automatically.
KORPUS_DATABASE_URL=sqlite://data/korpus.db

# IANA time zone used as the default during first-run setup
# (the active time zone is chosen in Settings).
KORPUS_DEFAULT_TIMEZONE=UTC

# Open Food Facts product lookup and search. When enabled, search words and
# barcodes you look up are sent to Open Food Facts; nothing else is.
KORPUS_OFF_ENABLED=true
KORPUS_OFF_BASE_URL=https://world.openfoodfacts.org
KORPUS_OFF_SEARCH_URL=https://search.openfoodfacts.org

# Contact (e-mail or URL) added to the User-Agent sent to Open Food Facts,
# as their API guidelines request. Recommended for public instances.
KORPUS_CONTACT=

# Timeout for external provider requests, in seconds (1-60).
KORPUS_PROVIDER_TIMEOUT_SECS=8

# Log filter (tracing EnvFilter syntax). Logs never contain diary contents.
KORPUS_LOG=korpus=info,tower_http=warn
